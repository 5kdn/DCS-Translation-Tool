<UserControl x:Class="DcsTranslationTool.Presentation.Wpf.UI.Dialogs.Views.ApplicationUpdateProgressDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AutomationProperties.AutomationId="ApplicationUpdateProgressDialog"
             d:DesignHeight="200"
             d:DesignWidth="480"
             Loaded="OnLoaded"
             mc:Ignorable="d">
    <Grid Width="440" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock AutomationProperties.AutomationId="ApplicationUpdateProgressTitle"
                   FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Grid.Row="1"
                   AutomationProperties.AutomationId="ApplicationUpdateProgressStatus"
                   Margin="0,20,0,8" Text="{Binding Status}" />
        <ProgressBar Grid.Row="2"
                     AutomationProperties.AutomationId="ApplicationUpdateProgressBar"
                     Height="8" Maximum="100" Value="{Binding Percentage, Mode=OneWay}" />
        <Button Grid.Row="3"
                AutomationProperties.AutomationId="ApplicationUpdateProgressCancelButton"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Content="{Binding CancelButtonText}"
                IsEnabled="{Binding IsRunning}"
                Click="OnCancel" />
    </Grid>
</UserControl>
